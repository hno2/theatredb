{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "DatePrecision": {
      "description": "Resolution of a calendar-domain date.",
      "enum": [
        "year",
        "month",
        "day",
        "minute"
      ],
      "title": "DatePrecision",
      "type": "string"
    },
    "DomainDate": {
      "anyOf": [
        {
          "pattern": "^(?:000[1-9]|00[1-9]\\d|0[1-9]\\d{2}|[1-9]\\d{3})(?:-(?:0[1-9]|1[0-2]))?$",
          "type": "string"
        },
        {
          "format": "date",
          "type": "string"
        },
        {
          "pattern": "^(?:(?:000[1-9]|00[1-9]\\d|0[1-9]\\d{2}|[1-9]\\d{3})-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12]\\d|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8]))|(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)[Tt ](?:[01]\\d|2[0-3])(?::[0-5]\\d(?::[0-5]\\d(?:\\.\\d{1,6})?)?)?(?:[Zz]|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "HttpURL": {
      "format": "uri",
      "minLength": 1,
      "pattern": "^https?://[^\\s/?#]+[^\\s]*$",
      "type": "string"
    },
    "NonEmptyText": {
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "NonNegativeInt": {
      "minimum": 0,
      "type": "integer"
    },
    "StagedMembership": {
      "additionalProperties": false,
      "description": "Person fields from Person, plus the source's production credit.\n\nA scalar type remains accepted for existing Karlsruhe snapshots; new\nproducers may use Person.type's list form. external_id is source metadata,\nnot a database ID; database links are resolved by reconciliation after review.",
      "properties": {
        "name": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "external_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonEmptyText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonEmptyText"
            },
            {
              "items": {
                "$ref": "#/$defs/NonEmptyText"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpURL"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "urls": {
          "items": {
            "$ref": "#/$defs/HttpURL"
          },
          "title": "Urls",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "born": {
          "$ref": "#/$defs/DomainDate",
          "default": null
        },
        "born_precision": {
          "anyOf": [
            {
              "$ref": "#/$defs/DatePrecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "died": {
          "$ref": "#/$defs/DomainDate",
          "default": null
        },
        "died_precision": {
          "anyOf": [
            {
              "$ref": "#/$defs/DatePrecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "nationality": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nationality"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "character": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Character"
        }
      },
      "required": [
        "name"
      ],
      "title": "StagedMembership",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "born_precision": {
                "const": "year"
              }
            },
            "required": [
              "born_precision"
            ]
          },
          "then": {
            "properties": {
              "born": {
                "type": "string",
                "pattern": "^\\d{4}"
              }
            },
            "required": [
              "born"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "born_precision": {
                "const": "month"
              }
            },
            "required": [
              "born_precision"
            ]
          },
          "then": {
            "properties": {
              "born": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}"
              }
            },
            "required": [
              "born"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "born_precision": {
                "const": "day"
              }
            },
            "required": [
              "born_precision"
            ]
          },
          "then": {
            "properties": {
              "born": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}"
              }
            },
            "required": [
              "born"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "born_precision": {
                "const": "minute"
              }
            },
            "required": [
              "born_precision"
            ]
          },
          "then": {
            "properties": {
              "born": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt ]\\d{2}"
              }
            },
            "required": [
              "born"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "died_precision": {
                "const": "year"
              }
            },
            "required": [
              "died_precision"
            ]
          },
          "then": {
            "properties": {
              "died": {
                "type": "string",
                "pattern": "^\\d{4}"
              }
            },
            "required": [
              "died"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "died_precision": {
                "const": "month"
              }
            },
            "required": [
              "died_precision"
            ]
          },
          "then": {
            "properties": {
              "died": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}"
              }
            },
            "required": [
              "died"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "died_precision": {
                "const": "day"
              }
            },
            "required": [
              "died_precision"
            ]
          },
          "then": {
            "properties": {
              "died": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}"
              }
            },
            "required": [
              "died"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "died_precision": {
                "const": "minute"
              }
            },
            "required": [
              "died_precision"
            ]
          },
          "then": {
            "properties": {
              "died": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt ]\\d{2}"
              }
            },
            "required": [
              "died"
            ]
          }
        }
      ]
    },
    "StagedProduction": {
      "additionalProperties": false,
      "description": "Source-facing Production fields; title maps to Production.name and Text.title.",
      "properties": {
        "title": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "url": {
          "$ref": "#/$defs/HttpURL"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "premiere": {
          "$ref": "#/$defs/DomainDate",
          "default": null
        },
        "premiere_precision": {
          "anyOf": [
            {
              "$ref": "#/$defs/DatePrecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "premiere_year": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Premiere Year"
        },
        "duration": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonNegativeInt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "age_rating": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonNegativeInt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tags": {
          "items": {
            "$ref": "#/$defs/NonEmptyText"
          },
          "title": "Tags",
          "type": "array"
        },
        "critics": {
          "items": {
            "$ref": "#/$defs/NonEmptyText"
          },
          "title": "Critics",
          "type": "array"
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "memberships": {
          "items": {
            "$ref": "#/$defs/StagedMembership"
          },
          "title": "Memberships",
          "type": "array"
        }
      },
      "required": [
        "title",
        "url"
      ],
      "title": "StagedProduction",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "premiere_precision": {
                "const": "year"
              }
            },
            "required": [
              "premiere_precision"
            ]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "premiere": {
                    "type": "string",
                    "pattern": "^\\d{4}"
                  }
                },
                "required": [
                  "premiere"
                ]
              },
              {
                "properties": {
                  "premiere_year": {
                    "type": "integer"
                  }
                },
                "required": [
                  "premiere_year"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "premiere_precision": {
                "const": "month"
              }
            },
            "required": [
              "premiere_precision"
            ]
          },
          "then": {
            "properties": {
              "premiere": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}"
              }
            },
            "required": [
              "premiere"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "premiere_precision": {
                "const": "day"
              }
            },
            "required": [
              "premiere_precision"
            ]
          },
          "then": {
            "properties": {
              "premiere": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}"
              }
            },
            "required": [
              "premiere"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "premiere_precision": {
                "const": "minute"
              }
            },
            "required": [
              "premiere_precision"
            ]
          },
          "then": {
            "properties": {
              "premiere": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt ]\\d{2}"
              }
            },
            "required": [
              "premiere"
            ]
          }
        }
      ]
    }
  },
  "description": "Non-empty production array accepted by the staging importer.",
  "items": {
    "$ref": "#/$defs/StagedProduction"
  },
  "minItems": 1,
  "title": "StagedProductions",
  "type": "array"
}
